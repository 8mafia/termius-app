# Database Configuration
POSTGRES_DB=parssh
POSTGRES_USER=parssh
POSTGRES_PASSWORD=your_secure_database_password_here
DATABASE_URL=postgresql://parssh:your_secure_database_password_here@db:5432/parssh

# Redis Configuration
REDIS_URL=redis://:your_secure_redis_password_here@redis:6379/0
REDIS_PASSWORD=your_secure_redis_password_here

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters_long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption Configuration
ENCRYPTION_KEY_BASE64=your_32_byte_base64_encoded_encryption_key

# SSH Gateway Configuration
SSH_GATEWAY_HOST=ssh-gateway
SSH_GATEWAY_PORT=8080

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Email Configuration (for password reset and notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true

# OAuth Configuration
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# SSL Configuration (for HTTPS mode)
DOMAIN=your-domain.com
SSL_EMAIL=your-ssl-certificate-email@domain.com

# Security Configuration
CORS_ORIGINS=http://localhost,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_COOKIES=false
CSRF_PROTECTION=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# Session Configuration
SESSION_TIMEOUT_MINUTES=30
MAX_CONCURRENT_SESSIONS=10

# File Upload Configuration
MAX_FILE_SIZE_MB=100
UPLOAD_PATH=/tmp/uploads

# Development/Production
ENVIRONMENT=production
DEBUG=false